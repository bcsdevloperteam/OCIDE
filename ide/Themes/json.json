{
  "language": "json",
  "extensions": [".json"],
  "syntax_colors": [
    {
      "token_type": "bracket",
      "regex": "[\\{\\}\\[\\]]",
      "colors": { "dark": "#F0F0F0", "light": "#000000" }
    },
    {
      "token_type": "property_key",
      "regex": "\"(?:\\\\\"|[^\"])*\"(?=\\s*:)",
      "colors": { "dark": "#9CDCFE", "light": "#0451A5" }
    },
    {
      "token_type": "string_value",
      "regex": "(?<=:\\s*)\"(?:\\\\\"|[^\"])*\"",
      "colors": { "dark": "#FFB28A", "light": "#A31515" }
    },
    {
      "token_type": "number_value",
      "regex": "\\b-?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b",
      "colors": { "dark": "#B5E8B0", "light": "#098658" }
    },
    {
      "token_type": "boolean_null_value",
      "regex": "\\b(true|false|null)\\b",
      "colors": { "dark": "#4EB4FF", "light": "#0000FF" }
    },
    {
      "token_type": "colon_comma",
      "regex": "[:,]",
      "colors": { "dark": "#F0F0F0", "light": "#000000" }
    }
  ]
}

