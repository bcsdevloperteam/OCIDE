{
  "language": "python",
  "extensions": [".py", ".pyw"],
  "syntax_colors": [
    {
      "token_type": "comment",
      "regex": "#[^\r\n]*",
      "colors": { "dark": "#72CA58", "light": "#008000" }
    },
    {
      "token_type": "string",
      "regex": "(?:\"\"\"[\\s\\S]*?\"\"\")|(?:'''[\\s\\S]*?''')|\"[^\"]*\"|'[^']*'",
      "colors": { "dark": "#FFB28A", "light": "#A31515" }
    },
    {
      "token_type": "keyword",
      "regex": "\\b(and|as|assert|async|await|break|class|continue|def|del|elif|else|except|finally|for|from|global|if|import|in|is|lambda|nonlocal|not|or|pass|raise|return|try|while|with|yield)\\b",
      "colors": { "dark": "#4EB4FF", "light": "#0000FF" }
    },
    {
      "token_type": "builtin_function",
      "regex": "\\b(print|len|range|type|str|int|float|list|dict|set|tuple|open|super|sum|min|max)(?=\\s*\\()",
      "colors": { "dark": "#FFE082", "light": "#795E26" }
    },
    {
      "token_type": "function_name",
      "regex": "(?<=def\\s+)[a-zA-Z_]\\w*",
      "colors": { "dark": "#FFE082", "light": "#795E26" }
    },
    {
      "token_type": "class_name",
      "regex": "(?<=class\\s+)[a-zA-Z_]\\w*",
      "colors": { "dark": "#4ED6BB", "light": "#267F99" }
    },
    {
      "token_type": "number",
      "regex": "\\b\\d+(\\.\\d+)?\\b",
      "colors": { "dark": "#B5E8B0", "light": "#098658" }
    },
    {
      "token_type": "decorator",
      "regex": "@[a-zA-Z_]\\w*",
      "colors": { "dark": "#FFE082", "light": "#795E26" }
    }
  ]
}

