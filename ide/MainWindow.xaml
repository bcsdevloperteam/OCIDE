<ui:FluentWindow x:Class="OCIDE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OCIDE"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:pages="clr-namespace:OCIDE.Pages"
        mc:Ignorable="d"
        Title="OCIDE" Height="700" Width="1100"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Title="OCIDE" Grid.Row="0">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="AppTitleText" Text="OCIDE" VerticalAlignment="Center" Margin="15,0,15,0" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:Button x:Name="HomeTitlebarButton" Content="Home" Appearance="Transparent" Icon="{ui:SymbolIcon Home24}" 
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" 
                               Click="HomeButton_Click" Visibility="Collapsed"/>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>
        
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ui:NavigationView
                x:Name="RootNavigation"
                Grid.Column="0"
                PaneDisplayMode="Left"
                IsBackButtonVisible="Visible"
                BackRequested="RootNavigation_BackRequested">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem x:Name="ProjectsMenuItem" Content="Projects" Icon="{ui:SymbolIcon FolderProhibited24}" TargetPageType="{x:Type pages:ProjectsPage}" />
                    <ui:NavigationViewItem x:Name="ExplorerMenuItem" Content="Explorer" Icon="{ui:SymbolIcon Document24}" TargetPageType="{x:Type pages:ExplorerPage}" Visibility="Collapsed"/>
                    <ui:NavigationViewItem x:Name="SearchMenuItem" Content="Search" Icon="{ui:SymbolIcon Search24}" TargetPageType="{x:Type pages:SearchPage}" Visibility="Collapsed"/>
                    <ui:NavigationViewItem x:Name="ExtensionsMenuItem" Content="Extensions" Icon="{ui:SymbolIcon PuzzlePiece24}" TargetPageType="{x:Type pages:ExtensionsPage}" Visibility="Collapsed"/>
                    <ui:NavigationViewItem x:Name="SourceControlMenuItem" Content="Source Control" Icon="{ui:SymbolIcon Branch24}" Visibility="Collapsed"/>
                    <ui:NavigationViewItem x:Name="AIExtensionsMenuItem" Content="AI Extensions" Icon="{ui:SymbolIcon Bot24}" Visibility="Collapsed"/>
                </ui:NavigationView.MenuItems>
                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem Content="Settings" Icon="{ui:SymbolIcon Settings24}" TargetPageType="{x:Type pages:SettingsPage}"/>
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>

            <Border x:Name="EditorBorder" Grid.Column="1" Background="#1E1E1E" CornerRadius="8,0,0,0" Margin="10,0,0,0" ClipToBounds="True">
                <TabControl x:Name="EditorTabs" Background="Transparent" BorderThickness="0" Margin="0" Visibility="Collapsed">
                    <TabControl.Resources>
                        <Style TargetType="TabControl">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabControl">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden" Background="#252526" Grid.Row="0">
                                                <TabPanel x:Name="HeaderPanel" Panel.ZIndex="1" KeyboardNavigation.TabIndex="1" IsItemsHost="True" />
                                            </ScrollViewer>
                                            <Border x:Name="Border" Grid.Row="1" Background="{TemplateBinding Background}" BorderThickness="0">
                                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="{TemplateBinding Padding}" />
                                            </Border>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <Style TargetType="TabItem">
                            <Setter Property="Background" Value="#2D2D2D"/>
                            <Setter Property="Foreground" Value="#9D9D9D"/>
                            <Setter Property="BorderThickness" Value="0,1,0,0"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Margin" Value="0,0,1,0"/>
                            <Setter Property="Padding" Value="14,8,10,8"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border Name="Border" Background="{TemplateBinding Background}"
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                CornerRadius="0"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter x:Name="ContentSite"
                                                              VerticalAlignment="Center"
                                                              HorizontalAlignment="Center"
                                                              ContentSource="Header" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#1E1E1E"/>
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                    <Condition Property="IsSelected" Value="False"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="Border" Property="Background" Value="#2A2D2E"/>
                                                <Setter Property="Foreground" Value="#CCCCCC"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>
                </TabControl>
            </Border>
        </Grid>
        
        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource SystemAccentColorPrimaryBrush}" Padding="15,4">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <ui:SymbolIcon Symbol="Code24" Foreground="White" Margin="0,0,8,0" FontSize="14"/>
                    <TextBlock Text="Ready" Foreground="White" VerticalAlignment="Center" Margin="0,0,20,0" FontSize="11" FontWeight="SemiBold"/>
                    
                    <ui:SymbolIcon Symbol="ErrorCircle20" Foreground="White" Margin="0,0,5,0" FontSize="14"/>
                    <TextBlock Text="0" Foreground="White" VerticalAlignment="Center" Margin="0,0,15,0" FontSize="11"/>
                    
                    <ui:SymbolIcon Symbol="Warning20" Foreground="White" Margin="0,0,5,0" FontSize="14"/>
                    <TextBlock Text="0" Foreground="White" VerticalAlignment="Center" Margin="0,0,15,0" FontSize="11"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="StatusLnColText" Text="Ln 1, Col 1" Foreground="White" VerticalAlignment="Center" Margin="0,0,15,0" FontSize="11"/>
                    <TextBlock x:Name="StatusSpacesText" Text="Spaces: 4" Foreground="White" VerticalAlignment="Center" Margin="0,0,15,0" FontSize="11"/>
                    <TextBlock x:Name="StatusEncodingText" Text="UTF-8" Foreground="White" VerticalAlignment="Center" Margin="0,0,15,0" FontSize="11"/>
                    <TextBlock x:Name="StatusLanguageText" Text="Plain Text" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
