<Page x:Class="OCIDE.Pages.ExplorerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:editor="clr-namespace:OCIDE.Editor"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ExplorerPage">
    <Page.Resources>
        <ContextMenu x:Key="FileContextMenu" x:Shared="False">
            <MenuItem Header="New File" Click="NewFile_Click"/>
            <MenuItem Header="New Folder" Click="NewFolder_Click"/>
            <Separator/>
            <MenuItem Header="Rename" Click="Rename_Click"/>
            <MenuItem Header="Delete" Click="Delete_Click"/>
        </ContextMenu>
    </Page.Resources>

    <Border Background="#252526" Width="280" HorizontalAlignment="Left" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <TextBlock Text="EXPLORER" Foreground="#CCCCCC" FontSize="11" FontWeight="Bold" Margin="20,15,0,10" Grid.Row="0"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,10,0" Grid.Row="0">
                <ui:Button Appearance="Transparent" Padding="4" Margin="2" ToolTip="New File" Click="NewFile_Click">
                    <ui:SymbolIcon Symbol="DocumentAdd24" FontSize="16" Foreground="#CCCCCC"/>
                </ui:Button>
                <ui:Button Appearance="Transparent" Padding="4" Margin="2" ToolTip="New Folder" Click="NewFolder_Click">
                    <ui:SymbolIcon Symbol="FolderAdd24" FontSize="16" Foreground="#CCCCCC"/>
                </ui:Button>
                <ui:Button Appearance="Transparent" Padding="4" Margin="2" ToolTip="Delete" Click="Delete_Click">
                    <ui:SymbolIcon Symbol="Delete24" FontSize="16" Foreground="#CCCCCC"/>
                </ui:Button>
                <ui:Button Appearance="Transparent" Padding="4" Margin="2" ToolTip="Refresh" Click="Refresh_Click">
                    <ui:SymbolIcon Symbol="ArrowCounterclockwise24" FontSize="16" Foreground="#CCCCCC"/>
                </ui:Button>
            </StackPanel>
            
            <TreeView x:Name="FileTreeView" Background="Transparent" BorderThickness="0" 
                      Grid.Row="1" Foreground="#CCCCCC"
                      SelectedItemChanged="FileTreeView_SelectedItemChanged">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="TreeViewItem_PreviewMouseRightButtonDown"/>
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="Padding" Value="4"/>
                        <Setter Property="ContextMenu" Value="{StaticResource FileContextMenu}"/>
                    </Style>
                </TreeView.ItemContainerStyle>
                
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Content="{Binding IconElement}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>
    </Border>
</Page>
