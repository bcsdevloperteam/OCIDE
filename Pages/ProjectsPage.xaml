<Page x:Class="OCIDE.Pages.ProjectsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProjectsPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Project Manager" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,20" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

        <Grid Grid.Row="1">
            <!-- EMPTY STATE -->
            <Grid x:Name="EmptyStateGrid" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <ui:CardAction Grid.Row="0" Margin="0,0,0,20" Height="150" HorizontalAlignment="Stretch" Click="AddProject_Click">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="FolderAdd24" FontSize="48" Margin="0,0,0,10" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                        <TextBlock Text="Add Project" FontSize="18" FontWeight="Medium" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </ui:CardAction>

                <ui:Card Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Welcome to OCIDE" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                        <TextBlock Text="Your 100% offline, native Windows 11 code editor." FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,40" HorizontalAlignment="Center"/>

                        <TextBlock Text="Recent Projects" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                        <ui:ListView BorderThickness="0" Background="Transparent" HorizontalAlignment="Center">
                            <ui:ListViewItem Content="No recent projects" IsEnabled="False" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalContentAlignment="Center"/>
                        </ui:ListView>
                    </StackPanel>
                </ui:Card>
            </Grid>

            <!-- POPULATED STATE -->
            <Grid x:Name="PopulatedStateGrid" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Your Workspaces" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    <ui:Button Grid.Column="1" Content="New Project" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Click="AddProject_Click" Padding="20,8"/>
                </Grid>

                <ui:Card Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Padding="0">
                    <ui:ListView x:Name="RecentProjectsListView" BorderThickness="0" Background="Transparent" SelectionChanged="RecentProjectsListView_SelectionChanged" Margin="0,10,0,10">
                        <ui:ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Folder24" FontSize="24" Margin="0,0,15,0" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Path}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{DynamicResource SystemAccentColorSecondaryBrush}" CornerRadius="10" Padding="8,4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Type}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ui:ListView.ItemTemplate>
                    </ui:ListView>
                </ui:Card>
            </Grid>
        </Grid>
    </Grid>
</Page>
