{
  "language": "css",
  "extensions": [".css"],
  "syntax_colors": [
    {
      "token_type": "comment",
      "regex": "/\\*[\\s\\S]*?\\*/",
      "colors": { "dark": "#72CA58", "light": "#008000" }
    },
    {
      "token_type": "at_rule",
      "regex": "@[a-zA-Z\\-]+",
      "colors": { "dark": "#E06CFF", "light": "#AF00DB" }
    },
    {
      "token_type": "selector_class_id",
      "regex": "[\\.#][a-zA-Z0-9_\\-]+",
      "colors": { "dark": "#FFD700", "light": "#800000" }
    },
    {
      "token_type": "property_name",
      "regex": "\\b([a-zA-Z\\-]+)(?=\\s*:)",
      "colors": { "dark": "#9CDCFE", "light": "#FF0000" }
    },
    {
      "token_type": "color_hex",
      "regex": "\\#[0-9a-fA-F]{3,8}\\b",
      "colors": { "dark": "#FFB28A", "light": "#0000FF" }
    },
    {
      "token_type": "number_with_unit",
      "regex": "\\b\\d+(\\.\\d+)?(px|em|rem|%|vh|vw|s|ms|deg)\\b",
      "colors": { "dark": "#B5E8B0", "light": "#098658" }
    }
  ]
}

