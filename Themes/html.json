{
  "language": "html",
  "extensions": [".html", ".htm"],
  "syntax_colors": [
    {
      "token_type": "comment",
      "regex": "<!--[\\s\\S]*?-->",
      "colors": { "dark": "#72CA58", "light": "#008000" }
    },
    {
      "token_type": "tag_bracket",
      "regex": "[<>]",
      "colors": { "dark": "#B0B0B0", "light": "#0000FF" }
    },
    {
      "token_type": "tag_name",
      "regex": "(?<=<\\/?)[a-zA-Z0-9\\-]+",
      "colors": { "dark": "#4EB4FF", "light": "#800000" }
    },
    {
      "token_type": "attribute_name",
      "regex": "\\b([a-zA-Z\\-]+)(?=\\s*=)",
      "colors": { "dark": "#9CDCFE", "light": "#FF0000" }
    },
    {
      "token_type": "attribute_value",
      "regex": "\"[^\"]*\"|'[^']*'",
      "colors": { "dark": "#FFB28A", "light": "#0000FF" }
    },
    {
      "token_type": "text_content",
      "regex": "(?<=>)[^<]+(?=<)",
      "colors": { "dark": "#F0F0F0", "light": "#000000" }
    }
  ]
}

