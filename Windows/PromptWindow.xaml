<ui:FluentWindow x:Class="OCIDE.Windows.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Prompt" Height="170" Width="350"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Title="Prompt" Grid.Row="0"/>

        <Grid Grid.Row="1" Margin="20,10,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ui:TextBox x:Name="InputBox" Grid.Row="0" VerticalAlignment="Top" PlaceholderText="Enter text..." KeyDown="InputBox_KeyDown" Foreground="#CCCCCC"/>
            
            <ui:Button x:Name="OkButton" Grid.Row="1" Content="OK" HorizontalAlignment="Right" Appearance="Primary" Width="80" Click="OkButton_Click"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
