{
  "Id": "lang.python",
  "Name": "Python Extension Pack",
  "Description": "IntelliSense, linting, and formatting for Python development.",
  "Author": "OCIDE Team",
  "Version": "1.0.0",
  "Snippets": {
    "def": [
      "def function_name():\n    pass"
    ],
    "if": [
      "if condition:\n    pass"
    ],
    "for": [
      "for item in collection:\n    pass"
    ],
    "class": [
      "class ClassName:\n    def __init__(self):\n        pass"
    ],
    "import": [
      "import os",
      "import sys",
      "import math"
    ],
    "print": [
      "print(\u0022hello\u0022)"
    ]
  }
}